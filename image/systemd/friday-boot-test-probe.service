# Friday Linux — NOT in SPEC.md; added this pass to make M0's acceptance
# checklist (SPEC.md §15) actually checkable from GitHub Actions CI.
#
# M0's checklist needs to observe two things from OUTSIDE the guest with no
# SSH server available (§10.2): "`bootc status` shows one deployment" and
# "/usr is read-only (`touch /usr/x` fails)". This unit runs both checks
# once, at boot, and writes the results to the console (ttyS0 under QEMU,
# captured on the host side via `-serial file:...` in
# .github/workflows/boot-test.yml) — the same headless-CI technique as
# friday-boot-test-relay.service, gated the same way (see that unit's
# header) so it is a silent no-op on every real deployment.
#
# 2026-09-01 addition: `journalctl -b` came back completely empty for the
# ENTIRE current boot (not just this unit — confirmed with an unfiltered
# `journalctl -b -n 60`) while diagnosing a real friday.service crash-loop
# regression, despite obvious console evidence that a huge amount of real
# activity had occurred. journald's own queryable store is broken far more
# deeply than the already-known per-user-journal permission issue.
# Bypassing it entirely for this one diagnosis: stop friday.service and
# invoke the same binary directly as the friday user with the same
# environment, piping its own stdout/stderr straight through this
# script's own shell (which reliably reaches the console, unlike anything
# routed through journald's apparently-broken storage).
#
# StandardOutput=journal+console is scoped to just this one-shot unit, not
# to friday.service or friday-firstboot.service — neither of those needed
# to change to make this observable.
[Unit]
Description=Friday Linux CI-only boot probe: bootc status + /usr write test (see header)
ConditionPathExists=/var/lib/friday/.provisioned-unattended
After=friday-firstboot.service multi-user.target
Wants=friday-firstboot.service

[Service]
Type=oneshot
StandardOutput=journal+console
StandardError=journal+console
# Moved out of an inline `/bin/sh -c '...'` into a real script file (CI run
# 33474200410: systemd's own ExecStart= parser does a naive quote-balance
# scan across the whole raw line — nesting bash's quoting rules inside it
# eventually breaks that scan and silently disables the entire unit:
# "Unbalanced quoting, ignoring" / "Unit configuration has fatal error, unit
# will not be started". A bare script path has no quoting to balance.
ExecStart=/usr/libexec/friday/boot-test-probe.sh

[Install]
WantedBy=multi-user.target
