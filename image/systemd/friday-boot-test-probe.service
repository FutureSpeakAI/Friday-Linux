# Friday Linux — NOT in SPEC.md; added this pass to make M0's acceptance
# checklist (SPEC.md §15) actually checkable from GitHub Actions CI.
#
# M0's checklist needs to observe two things from OUTSIDE the guest with no
# SSH server available (§10.2): "`bootc status` shows one deployment" and
# "/usr is read-only (`touch /usr/x` fails)". This unit runs both checks
# once, at boot, and writes the results to the console (ttyS0 under QEMU,
# captured on the host side via `-serial file:...` in
# .github/workflows/boot-test.yml) — the same headless-CI technique as
# friday-boot-test-relay.service, gated the same way (see that unit's
# header) so it is a silent no-op on every real deployment.
#
# 2026-09-01 addition: `journalctl -b` came back completely empty for the
# ENTIRE current boot (not just this unit — confirmed with an unfiltered
# `journalctl -b -n 60`) while diagnosing a real friday.service crash-loop
# regression, despite obvious console evidence that a huge amount of real
# activity had occurred. journald's own queryable store is broken far more
# deeply than the already-known per-user-journal permission issue.
# Bypassing it entirely for this one diagnosis: stop friday.service and
# invoke the same binary directly as the friday user with the same
# environment, piping its own stdout/stderr straight through this
# script's own shell (which reliably reaches the console, unlike anything
# routed through journald's apparently-broken storage).
#
# StandardOutput=journal+console is scoped to just this one-shot unit, not
# to friday.service or friday-firstboot.service — neither of those needed
# to change to make this observable.
[Unit]
Description=Friday Linux CI-only boot probe: bootc status + /usr write test (see header)
ConditionPathExists=/var/lib/friday/.provisioned-unattended
After=friday-firstboot.service multi-user.target
Wants=friday-firstboot.service

[Service]
Type=oneshot
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/bin/sh -c '\
  echo "FRIDAY-BOOT-TEST-PROBE-BEGIN"; \
  echo "--- /var/log/friday-firstboot.log (real, unexplained: journalctl -u friday-firstboot has come up empty here even right after a provably successful run — docs/DECISIONS.md) ---"; \
  cat /var/log/friday-firstboot.log 2>&1; \
  echo "--- journalctl -u friday-firstboot.service (full, explicit suffix) ---"; \
  journalctl -u friday-firstboot.service --no-pager 2>&1; \
  echo "--- journalctl -t wizard.py (by syslog identifier instead of unit) ---"; \
  journalctl -t wizard.py --no-pager 2>&1; \
  echo "--- journalctl -u friday.service (last 100 lines) ---"; \
  journalctl -u friday.service --no-pager -n 100 2>&1; \
  echo "--- B5 regression: on-disk state of the app-level setup marker ---"; \
  ls -la /home/friday/.friday/ 2>&1; \
  echo "--- marker content ---"; \
  cat /home/friday/.friday/.setup_complete 2>&1; \
  echo "--- what cli.py actually sees for FRIDAY_HOME / friday_home() / SETUP_MARKER.exists() ---"; \
  ( set -a; \
    . /etc/friday/os.env; \
    if [ -f /var/lib/friday/secrets.env ]; then . /var/lib/friday/secrets.env; fi; \
    set +a; \
    runuser -u friday -- /usr/lib/friday/venv/bin/python3 -c "\
import os
from pathlib import Path
print('FRIDAY_HOME env =', repr(os.environ.get('FRIDAY_HOME')))
print('Path.home() =', Path.home())
from agent_friday.paths import friday_home
fh = friday_home()
print('friday_home() =', fh)
marker = fh / '.setup_complete'
print('marker path =', marker, 'exists =', marker.exists())
import agent_friday.cli as cli
print('cli.FRIDAY_DIR =', cli.FRIDAY_DIR)
print('cli.SETUP_MARKER =', cli.SETUP_MARKER, 'exists =', cli.SETUP_MARKER.exists())
print('_is_existing_user() =', cli._is_existing_user())
" \
  ) 2>&1; \
  echo "--- direct invocation of the friday binary, bypassing journald entirely ---"; \
  echo "--- (journalctl has come up completely empty for this whole boot, even unfiltered -- see docs/DECISIONS.md) ---"; \
  systemctl stop friday.service 2>&1; \
  ( set -a; \
    . /etc/friday/os.env; \
    if [ -f /var/lib/friday/secrets.env ]; then . /var/lib/friday/secrets.env; fi; \
    set +a; \
    cd /home/friday && runuser -u friday -- timeout 20 /usr/lib/friday/venv/bin/friday \
  ) 2>&1 | head -300; \
  echo "--- end direct invocation ---"; \
  echo "--- systemctl list-units --failed ---"; \
  systemctl list-units --failed --no-pager 2>&1; \
  echo "--- bootc status ---"; \
  bootc status --json 2>&1; \
  echo "--- /usr write test ---"; \
  if touch /usr/.friday-boot-test-writeprobe 2>/tmp/usr-write.err; then \
    echo "USR_WRITABLE=yes (unexpected — /usr should be read-only)"; \
    rm -f /usr/.friday-boot-test-writeprobe; \
  else \
    echo "USR_WRITABLE=no ($(cat /tmp/usr-write.err))"; \
  fi; \
  echo "--- findmnt /usr ---"; \
  findmnt -no SOURCE,TARGET,FSTYPE,OPTIONS /usr 2>&1; \
  echo "--- findmnt /boot/efi ---"; \
  findmnt -no SOURCE,TARGET,FSTYPE,OPTIONS /boot/efi 2>&1; \
  echo "--- lockbox subvolumes (btrfs subvolume list) ---"; \
  btrfs subvolume list /friday/lockbox 2>&1; \
  echo "--- lsblk ---"; \
  lsblk -o NAME,TYPE,FSTYPE,SIZE,MOUNTPOINT 2>&1; \
  echo "FRIDAY-BOOT-TEST-PROBE-END"'

[Install]
WantedBy=multi-user.target
