# Friday Linux — SPEC.md §8.3. The cage/chromium invocation is copied
# verbatim from the spec; the tty1 autologin mechanism (getty override) is
# authored since the spec describes the behaviour but not the override file
# — see the companion getty override below.
[Unit]
Description=Friday kiosk (cage + Chromium)
After=friday-lockbox.mount friday-caddy.service systemd-user-sessions.service
Wants=friday-caddy.service
Conflicts=getty@tty1.service
ConditionPathExists=/var/lib/friday/.firstboot-done

[Service]
User=friday
Group=friday
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/cage -- /usr/bin/chromium --kiosk --ozone-platform=wayland --enable-features=VaapiVideoDecoder --disable-pinch --overscroll-history-navigation=0 https://localhost/
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
