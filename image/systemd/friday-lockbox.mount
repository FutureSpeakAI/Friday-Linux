# Friday Linux — SPEC.md §5, §8. FIRST-DRAFT / NEEDS REVIEW.
#
# The spec's architecture diagram (§4) and friday.service (§8.1, copied
# verbatim in friday.service) both reference a single unit named exactly
# "friday-lockbox.mount" that other units gate on. A systemd .mount unit
# corresponds to exactly one mountpoint, but §5 mounts FIVE btrfs subvolumes
# to five different paths (@home, @models, @workshop, @journal, @snapshots),
# and §7.3 step 4 says the first-boot wizard "writes /etc/crypttab and the
# mount units" — meaning the real per-subvolume mount units are generated at
# first boot, not baked into the image, since the lockbox doesn't exist
# until then (ADR-004).
#
# This file is therefore the OUTER mount only: it decrypts and mounts the
# lockbox's top-level btrfs volume so its subvolumes become mountable. The
# per-subvolume units (home-friday.mount, var-lib-friday-models.mount,
# var-lib-friday-workshop.mount, var-log-journal.mount) are written by
# image/firstboot/ alongside /etc/crypttab, each with
# "RequiresMountsFor=/friday/lockbox" so they gate on this unit, and
# friday.service's After=friday-lockbox.mount should arguably be
# After=friday-lockbox.mount home-friday.mount var-lib-friday-models.mount —
# but the spec's given friday.service text (§8.1) names only
# friday-lockbox.mount, so that text is kept verbatim in friday.service and
# this ambiguity is recorded in docs/DECISIONS.md under "Deviations" rather
# than silently resolved by editing the spec's given unit file.
#
# /etc/crypttab (written by the first-boot wizard, not this repo):
#   friday-lockbox  UUID=<lockbox-partition-uuid>  none  luks
#
# REAL BOOT FAILURE, CI run 33340378275 (docs/DECISIONS.md): systemd
# rejected this unit outright at boot — "friday-lockbox.mount: Where=
# setting doesn't match unit name. Refusing." — with the previous Where=
# value of /run/friday-lockbox. Confirmed against systemd's own source
# (src/basic/unit-name.c, unit_name_unescape(): every literal '-' in a
# unit name is converted back to '/' when deriving its path; there is no
# other representation of '/' in a unit name). This means a literal hyphen
# WITHIN a single path component must be escaped as \x2d to survive
# round-tripping — "/run/friday-lockbox" would need to be named
# "run-friday\x2dlockbox.mount", not the literal "friday-lockbox.mount"
# that SPEC.md's friday.service text (§8.1, kept verbatim) requires. The
# ONLY path whose escaped form is exactly "friday-lockbox.mount" is
# "/friday/lockbox" (two real path components, "friday" then "lockbox" —
# the hyphen in the unit name IS the separator representing that real
# "/", not a literal character needing escaping). Moved Where= there.
# "/friday/lockbox" is pre-created in the Containerfile (mkdir -p) so the
# mountpoint directory exists in the sealed, read-only image — mount does
# not need write access to create it at runtime, only an existing
# directory entry to mount onto.
#
[Unit]
Description=Friday lockbox (LUKS2 + btrfs top-level volume)
Before=friday.service
# Deviation from the previous draft (docs/DECISIONS.md): RequiresMountsFor
# expects a PATH that some OTHER mount provides, not a /dev node — it does
# not do what the comment above used to claim ("wait until this device node
# appears"). The correct systemd idiom for that is a dependency on the
# auto-generated .device unit for a udev-visible node: systemd escapes
# "/dev/mapper/friday-lockbox" into the unit name
# "dev-mapper-friday\x2dlockbox.device". BindsTo+After means this mount is
# torn down if that device disappears, and does not even attempt to start
# before it exists.
BindsTo=dev-mapper-friday\x2dlockbox.device
After=dev-mapper-friday\x2dlockbox.device

[Mount]
What=/dev/mapper/friday-lockbox
Where=/friday/lockbox
Type=btrfs
Options=subvolid=5,noatime

[Install]
WantedBy=multi-user.target
