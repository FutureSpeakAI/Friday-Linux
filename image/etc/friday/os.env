# Friday Linux — SPEC.md §8.1, copied verbatim except FRIDAY_HOME (Deviation
# D-A21, docs/DECISIONS.md): SPEC.md §5 states the literal value
# FRIDAY_HOME=/home/friday but its own stated intent is "the app's default
# ~/.friday layout is unchanged" — real v5.9.0 agent_friday.paths.friday_home()
# uses a set FRIDAY_HOME as-is (no ".friday" suffix appended, unlike its
# unset fallback of Path.home() / ".friday"), so the literal SPEC.md value
# does not achieve the intent SPEC.md itself states. Corrected to the value
# that does.
FRIDAY_OS_MODE=1
FRIDAY_HOME=/home/friday/.friday
FRIDAY_BIND_HOST=127.0.0.1
FRIDAY_PORT=3000
FRIDAY_LLAMA_SERVER_BIN=/usr/libexec/friday/llama-server-cuda:/usr/libexec/friday/llama-server-vulkan
FRIDAY_MODELS_DIR=/var/lib/friday/models
FRIDAY_VOICE_ASSETS=/usr/share/friday/voice
FRIDAY_LOG_TARGET=stdout
FRIDAY_TRUST_LOOPBACK=1
